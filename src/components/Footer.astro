---
import siteConfig from '../data/site-config';
import SocialLink from './SocialLink.astro';

const socialLinks = siteConfig.socialLinks || [];
const secondaryNavLinks = siteConfig.secondaryNavLinks || [];
---

<footer class="px-4 py-10 border-t border-rule sm:px-8 sm:py-14">
    {
        secondaryNavLinks.length > 0 && (
            <div class="w-full max-w-3xl mx-auto mb-4 flex flex-wrap gap-x-8 gap-y-1 justify-center">
                {secondaryNavLinks.map((link) => (
                    <a class="text-lg text-ink transition-colors duration-200 hover:text-accent" href={link.href}>
                        {link.text}
                    </a>
                ))}
            </div>
        )
    }
    {
        socialLinks.length > 0 && (
            <div class="w-full max-w-3xl mx-auto mb-4 flex flex-wrap gap-x-2 gap-y-3 justify-center">
                {socialLinks.map((link) => (
                    <SocialLink {...link} class="text-muted hover:text-accent" />
                ))}
            </div>
        )
    }
    <p class="text-center text-sm italic text-muted">
        &copy; {new Date().getFullYear()}&nbsp;<a class="text-ink underline decoration-1 underline-offset-4 hover:text-accent" href="/">{siteConfig.title}</a>. Created with Astro.js
    </p>
</footer>

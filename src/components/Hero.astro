---
import siteConfig from '../data/site-config.ts';
import SocialLink from './SocialLink.astro';

const hero = siteConfig.hero;
const socialLinks = siteConfig.socialLinks || [];
---

{
    (hero?.title || hero?.text || hero?.avatar?.src) && (
        <>
            {hero?.backgroundImage?.src && (
                <div
                    class="absolute inset-0 bg-cover bg-center opacity-10 grayscale mix-blend-multiply"
                    style={{ backgroundImage: `url(${hero?.backgroundImage?.src})` }}
                />
            )}
            <section class="px-4 pt-12 pb-16 relative sm:px-8 sm:pt-16 sm:pb-24">
                <div class="w-full max-w-3xl mx-auto flex flex-col items-center text-center">
                    {hero?.avatar?.src && (
                        <img
                            src={hero?.avatar?.src}
                            alt={hero?.avatar?.alt || ''}
                            class="w-28 aspect-square object-cover rounded-full ring-1 ring-ink/15 ring-offset-4 ring-offset-paper"
                        />
                    )}
                    {hero?.title && (
                        <h1
                            class:list={[
                                'font-display text-5xl font-medium leading-[1.05] tracking-tight text-ink sm:text-7xl',
                                { 'mt-8': hero?.avatar?.src }
                            ]}
                        >
                            {hero?.title}
                        </h1>
                    )}
                    {hero?.text && (
                        <p
                            class:list={[
                                'max-w-2xl text-xl leading-relaxed text-ink/80 sm:text-2xl',
                                { 'mt-6': hero?.title || hero?.avatar?.src }
                            ]}
                        >
                            {hero?.text}
                        </p>
                    )}
                    {socialLinks.length > 0 && (
                        <div class:list={['flex flex-wrap gap-x-2 gap-y-3 justify-center', { 'mt-8': hero?.avatar?.src || hero?.title || hero?.text }]}>
                            {socialLinks.map((link) => (
                                <SocialLink {...link} class="text-muted hover:text-accent" />
                            ))}
                        </div>
                    )}
                </div>
            </section>
        </>
    )
}

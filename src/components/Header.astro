---
import HeaderNavLink from './HeaderNavLink.astro';
import WrittenLogo from './WrittenLogo.astro';
import siteConfig from '../data/site-config.ts';
import RSS from '../icons/RSS.astro';
import ThemeToggle from './ThemeToggle.astro';

const primaryNavLinks = siteConfig.primaryNavLinks || [];

const { class: className } = Astro.props;

const { pathname } = Astro.url;
const isActive = (href: string) => href === pathname || href === pathname.replace(/\/$/, '');
---

<header class:list={['px-4 py-4 flex gap-6 items-center justify-between sm:px-8 sm:py-6', className]}>
    {
        siteConfig.logo && siteConfig.logo?.src ? (
            <a href="/">
                <WrittenLogo class="h-12 w-auto dark:invert" alt={siteConfig.logo.alt || siteConfig.title} />
            </a>
        ) : (
            <a class="font-display text-xl font-medium sm:text-2xl" href="/">
                {siteConfig.title}
            </a>
        )
    }
    <div class="flex items-center gap-4 md:gap-8">
    {
        primaryNavLinks.length > 0 && (
            <>
                <nav class="hidden md:block" aria-label="Primary">
                    <ul class="flex items-center gap-8">
                        {primaryNavLinks.map((link) => (
                            <li>
                                <a
                                    class:list={[
                                        'text-lg transition-colors duration-200 hover:text-accent',
                                        isActive(link.href) ? 'text-accent underline decoration-1 underline-offset-[6px]' : 'text-ink'
                                    ]}
                                    href={link.href}
                                    aria-current={isActive(link.href) ? 'page' : undefined}
                                >
                                    {link.text === 'RSS' ? <RSS class="w-5 h-5" role="img" aria-label="RSS feed" /> : link.text}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
                <nav class="relative md:hidden" aria-label="Primary (mobile)">
                    <button
                        class="menu-toggle w-10 h-10 inline-flex items-center justify-center border border-ink text-ink relative z-20 transition-colors duration-200 hover:bg-ink/5"
                        aria-label="Open Menu"
                        aria-expanded="false"
                        aria-controls="menu-items"
                    >
                        <span class="menu-toggle-icon w-1 h-1 relative bg-ink rounded-full" />
                    </button>
                    <ul id="menu-items" class="menu absolute -top-3 -right-3 px-5 pt-16 pb-3 bg-paper border border-rule z-10">
                        {primaryNavLinks.map((link) => (
                            <li class="border-b border-rule last:border-b-0">
                                <HeaderNavLink
                                    class="block pr-6 py-2 text-xl font-display text-ink relative transition-colors duration-200 hover:text-accent"
                                    href={link.href}
                                >
                                    {link.text === 'RSS' ? <RSS class="w-5 h-5" role="img" aria-label="RSS feed" /> : link.text}
                                </HeaderNavLink>
                            </li>
                        ))}
                    </ul>
                </nav>
            </>
        )
    }
    <ThemeToggle />
    </div>
</header>

<style>
    @reference "../styles/global.css";
    .menu {
        width: calc(100vw - 0.5rem);
        max-width: 18.75rem;
        box-shadow: 0 12px 32px rgb(var(--color-ink) / 0.08);
        opacity: 0;
        transform: scale(0.6);
        transform-origin: top right;
        transition:
            transform 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.3s,
            opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1) 0.25s,
            visibility 0s 0.5s;
        visibility: hidden;
    }
    .menu.is-visible {
        opacity: 1;
        transform: scale(1);
        transition:
            transform 0.25s cubic-bezier(0.4, 0, 0.2, 1) 0.25s,
            opacity 0.15s 0.15s,
            visibility 0s 0.25s;
        visibility: visible;
    }
    .menu-toggle-icon {
        transition:
            height 0s 0.25s,
            width 0s 0.25s;
    }
    .menu-toggle-icon.is-active {
        height: 3px;
        width: 3px;
    }
    .menu-toggle-icon:before,
    .menu-toggle-icon:after {
        @apply w-1 h-1 absolute left-1/2 top-1/2 bg-ink rounded-full -translate-x-1/2 -translate-y-1/2;
        content: '';
        transition:
            width 0.25s cubic-bezier(0.4, 0, 0.2, 1),
            height 0s 0.25s,
            transform 0s 0.25s,
            margin 0.25s cubic-bezier(0.4, 0, 0.2, 1) 0.25s;
    }
    .menu-toggle-icon:before {
        @apply -ml-2;
    }
    .menu-toggle-icon:after {
        @apply ml-2;
    }
    .menu-toggle-icon.is-active:before,
    .menu-toggle-icon.is-active:after {
        @apply w-5 ml-0 rounded-md;
        height: 3px;
        transition:
            margin 0.25s cubic-bezier(0.4, 0, 0.2, 1),
            height 0s 0.25s,
            transform 0s 0.25s,
            width 0.25s cubic-bezier(0.4, 0, 0.2, 1) 0.25s;
    }
    .menu-toggle-icon.is-active:before {
        @apply rotate-45;
    }
    .menu-toggle-icon.is-active:after {
        @apply -rotate-45;
    }
</style>

<script>
    function menuToggle() {
        const menu = document.querySelector('.menu');
        const menuToggleBtn = document.querySelector('.menu-toggle');
        const menuToggleIcon = document.querySelector('.menu-toggle-icon');
        menuToggleBtn?.addEventListener('click', () => {
            const isMenuExpanded = menuToggleBtn.getAttribute('aria-expanded') === 'true';
            menuToggleBtn.setAttribute('aria-expanded', isMenuExpanded ? 'false' : 'true');
            menuToggleBtn.setAttribute('aria-label', isMenuExpanded ? 'Open Menu' : 'Close Menu');
            menuToggleIcon?.classList.toggle('is-active');
            menu?.classList.toggle('is-visible');
        });
    }
    menuToggle();
    document.addEventListener('astro:after-swap', menuToggle);
</script>

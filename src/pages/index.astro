---
import { getCollection } from 'astro:content';
import NoHeaderLayout from '../layouts/NoHeaderLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeaturedPostPreview from '../components/FeaturedPostPreview.astro';
import PostPreview from '../components/PostPreview.astro';
import siteConfig from '../data/site-config';
import { sortPostsByDateDesc } from '../utils/post-utils';

const posts = (await getCollection('blog')).sort(sortPostsByDateDesc);
const featuredPosts = posts.filter(({ data }) => data.isFeatured);
const latestPosts = posts.filter(({ data }) => !data.isFeatured).slice(0, 3);
---

<NoHeaderLayout description={siteConfig.description} image={siteConfig.image}>
    <div class="relative border-b border-rule">
        <Header class="relative" />
        <Hero />
    </div>
    <main class="grow py-12 sm:py-20">
        {
            featuredPosts?.length > 0 && (
                <div class="px-4 mb-12 border-b border-rule sm:px-8 sm:mb-16">
                    <div class="max-w-6xl mx-auto">
                        {featuredPosts.map((post) => (
                            <FeaturedPostPreview post={post} />
                        ))}
                    </div>
                </div>
            )
        }
        {
            latestPosts?.length > 0 && (
                <div class="px-4 mb-12 sm:px-8 sm:mb-16">
                    <div class="max-w-3xl mx-auto mb-10 pb-3 border-b border-ink sm:mb-12">
                        <h2 class="font-display text-2xl font-medium italic text-ink">
                            Latest Articles
                        </h2>
                    </div>
                    <div class="max-w-3xl mx-auto">
                        {latestPosts.map((post) => (
                            <PostPreview post={post} />
                        ))}
                    </div>
                    <div class="max-w-3xl mx-auto pt-8 border-t border-rule sm:pt-10">
                        <a
                            class="font-display text-lg italic text-accent underline decoration-1 underline-offset-4 transition-colors duration-200 hover:text-ink"
                            href="/blog"
                        >
                            View All Posts →
                        </a>
                    </div>
                </div>
            )
        }
    </main>
</NoHeaderLayout>

---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { type Image } from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
    const pages = await getCollection('pages');
    return pages.map((page) => {
        return {
            params: { slug: page.id },
            props: { page }
        };
    });
}

const { page } = Astro.props as { page: CollectionEntry<'pages'> };
const { title, featureImage, seo } = page.data;
const { Content } = await render(page);
let socialImage: Image | undefined;
if (featureImage?.src) {
    socialImage = featureImage;
}
if (seo?.image?.src) {
    socialImage = seo.image;
}
---

<BaseLayout title={seo?.title ?? title} description={seo?.description} image={socialImage}>
    <main class="grow px-4 py-12 sm:px-8 sm:py-16">
        <article class="max-w-6xl mx-auto">
            <header class="max-w-3xl mx-auto mb-10 pb-6 border-b border-rule">
                <h1 class="font-display text-5xl font-medium leading-[1.05] tracking-tight text-ink sm:text-6xl">{title}</h1>
            </header>
            {
                featureImage?.src && (
                    <figure class="max-w-2xl mx-auto mb-10">
                        <img src={featureImage.src} loading="lazy" decoding="async" alt={featureImage.alt || ''} class="w-full" />
                        {featureImage.caption && <figcaption class="mt-2 text-sm italic text-muted">{featureImage.caption}</figcaption>}
                    </figure>
                )
            }
            <div class="max-w-3xl mx-auto">
                <div class="prose sm:prose-lg max-w-none">
                    <Content />
                </div>
            </div>
        </article>
    </main>
</BaseLayout>
